{
  "name": "icons-monorepo",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "generate-registry": "pnpm --filter @web-portfolio/icons-core generate-registry",
    "seed-devicon": "pnpm --filter @web-portfolio/icons-db seed-devicon"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  }
}
