{
  "name": "@web-portfolio/icons-sanity",
  "version": "1.0.1",
  "description": "Sanity Studio icon picker input, backed by the same bundled registry as @web-portfolio/icons.",
  "license": "MIT",
  "keywords": [
    "sanity",
    "sanity-plugin",
    "sanity-io",
    "icon-picker",
    "icons",
    "cms"
  ],
  "homepage": "https://github.com/jatinrao/icons#readme",
  "bugs": {
    "url": "https://github.com/jatinrao/icons/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build && pnpm verify-package",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify-package": "node scripts/verify-package.mjs"
  },
  "peerDependencies": {
    "@sanity/icons": ">=3",
    "@sanity/ui": ">=2",
    "@web-portfolio/icons": ">=1.0.1",
    "react": ">=18",
    "sanity": ">=3",
    "styled-components": ">=6"
  },
  "devDependencies": {
    "@sanity/icons": "^3.8.0",
    "@sanity/ui": "^2.10.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@web-portfolio/icons": "workspace:*",
    "@web-portfolio/icons-core": "workspace:*",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sanity": "^3.68.0",
    "styled-components": "^6.1.13",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jatinrao/icons.git",
    "directory": "packages/sanity-plugin"
  }
}
