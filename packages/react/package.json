{
  "name": "@web-portfolio/icons",
  "version": "1.0.4",
  "description": "Free React icon component with 633 bundled SVG icons (devicon, Material Symbols, Simple Icons) — zero runtime dependencies.",
  "license": "MIT",
  "keywords": [
    "react",
    "icon",
    "icons",
    "svg",
    "component",
    "devicon",
    "material-symbols",
    "simple-icons",
    "icon-library",
    "free-icons",
    "tech-stack-icons",
    "typescript"
  ],
  "homepage": "https://github.com/jatinrao/icons#readme",
  "bugs": {
    "url": "https://github.com/jatinrao/icons/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build && pnpm verify-package",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify-package": "node scripts/verify-package.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@web-portfolio/icons-core": "workspace:*",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jatinrao/icons.git",
    "directory": "packages/react"
  }
}
